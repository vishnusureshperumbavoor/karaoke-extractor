#!/usr/bin/env bash
set -e

cd "$(dirname "$0")"

BACKEND_PORT="${BACKEND_PORT:-5000}"

echo "=========================================="
echo "🚀 Starting Vibe Rapper Backend..."
echo "🔗 Backend API: http://localhost:${BACKEND_PORT}"
echo "=========================================="

if [ -x "./venv/bin/python" ]; then
    exec ./venv/bin/python app.py
else
    echo "⚠️  Virtual environment not found at ./venv, falling back to system python3..."
    exec python3 app.py
fi
